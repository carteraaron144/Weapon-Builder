// Template (skipped because the name starts with '_'). Copy it to <id>.json.
// The part's origin is where it attaches; it grows along +Y. Vectors are [x, y, z]; rotations are degrees.
{
  "id": "example",                 // unique
  "name": "Example Part",          // shown in the palette
  "category": "Blades & Heads",    // palette tab: Handles, Guards, Pommels, Blades & Heads
  "tags": ["blade"],               // what it is; a socket accepts it if they share a tag (roots need "handle")
  "length": 0.8,                   // size along +Y, for fitting to sockets
  "width": 0.06,                   // widest size across, for fitting to sockets
  "defaultMaterial": "steel",      // steel, iron, wood, leather, brass
  "sockets": [
    {
      "name": "tip",               // unique on this part
      "position": [0, 0.8, 0],
      "rotation": [0, 0, 0],       // the socket's +Y points away from this part
      "accepts": ["head"],         // at least one tag
      "length": 0.3, "width": 0.1, // the size a part on it is scaled to fit (tighter axis wins, 0.25x-4x)
      "required": false,
      "rotationStep": 90           // R spins a part on this socket by this much; 0 = no spin
    }
  ],
  "mesh": [
    // box: size = extents. prism: [top radius, height, bottom radius], sides. sphere: [radius, rings, 0], sides. ring: [inner, outer, 0], sides (lies flat in XZ).
    { "shape": "box", "size": [0.06, 0.8, 0.01], "position": [0, 0.4, 0], "rotation": [0, 0, 0], "scale": [1, 1, 1] }
  ]
}
